# Copy to `.env` (gitignored) and fill in. Both are read at build time by Expo,
# so restart Metro after changing them.

# Clerk → API keys → Publishable key. lib/clerk.ts throws at import if absent.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Convex → Settings → Deployment URL, or whatever `npx convex dev` prints.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# The following are NOT read from this file. They live on the Convex
# deployment, and the backend cannot start without them:
#
#   npx convex env set GEMINI_API_KEY ...
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-clerk-domain>
#
# CLERK_JWT_ISSUER_DOMAIN is the "Issuer" of a Clerk JWT template that must be
# named exactly `convex`. Without that template Convex never authenticates the
# session and the app sits on its connecting spinner.
# ---------------------------------------------------------------------------
